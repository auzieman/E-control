group { name: "elm/button/base/frost-action"; min: 100 34;
 script { new disabled; }
 parts {
  part { name: "plate"; type: IMAGE; mouse_events: 0;
   description { state: "default" 0.0; image { normal: "rail.svg"; border: 20 20 16 16; } }
   description { state: "pressed" 0.0; inherit: "default" 0.0; color: 190 216 232 255; }
  }
  part { name: "elm.text"; type: TEXT; mouse_events: 0;
   description { state: "default" 0.0; rel1.offset: 19 3; rel2.offset: -20 -4; color: 38 58 73 255;
    text { font: "DejaVu Sans"; size: 12; min: 1 1; align: 0.5 0.5; } }
  }
  part { name: "focus"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; rel1.relative: 0.15 0.86; rel2.relative: 0.85 0.9; color: 74 137 177 0; }
   description { state: "focused" 0.0; inherit: "default" 0.0; color: 74 137 177 255; }
  }
  part { name: "disabled"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; color: 224 233 239 0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: 224 233 239 150; }
  }
  part { name: "hit"; type: RECT; mouse_events: 1; description { state: "default" 0.0; color: 0 0 0 0; } }
 }
 programs {
  program { signal: "mouse,down,1"; source: "hit"; script { if (!disabled) { set_state(PART:"plate", "pressed", 0.0); emit("elm,action,press", ""); } } }
  program { signal: "mouse,up,1"; source: "hit"; script { set_state(PART:"plate", "default", 0.0); if (!disabled) emit("elm,action,unpress", ""); } }
  program { signal: "mouse,clicked,1"; source: "hit"; script { if (!disabled) emit("elm,action,click", ""); } }
  program { signal: "elm,state,disabled"; source: "elm"; script { disabled = 1; set_state(PART:"disabled", "disabled", 0.0); set_state(PART:"plate", "default", 0.0); } }
  program { signal: "elm,state,enabled"; source: "elm"; script { disabled = 0; set_state(PART:"disabled", "default", 0.0); } }
  program { signal: "elm,action,focus"; source: "elm"; action: STATE_SET "focused" 0.0; target: "focus"; }
  program { signal: "elm,action,unfocus"; source: "elm"; action: STATE_SET "default" 0.0; target: "focus"; }
 }
}
